# Database
DATABASE_URL=postgresql://squire:squire_dev@localhost:5435/squire

# API Server
PORT=3000
NODE_ENV=development

# Embeddings
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
EMBED_DIMENSION=768
OLLAMA_URL=http://localhost:11434

# Alternative: mxbai-embed-large (1024 dimensions)
# EMBED_MODEL=mxbai-embed-large
# EMBED_DIMENSION=1024

# LLM Provider - OpenAI API (recommended for Squire Agent)
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.5
OPENAI_API_KEY=your_openai_api_key_here
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.7

# Alternative: Anthropic Claude
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Alternative: Groq with llama-3.3-70b
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=your_groq_api_key_here

# Alternative: Google Gemini
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-1.5-pro
# GEMINI_API_KEY=your_gemini_api_key_here

# Alternative: Ollama for local LLM
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2

# Runtime slots
# ROUTING_SMART_PROVIDER=openai
# ROUTING_SMART_MODEL=gpt-5.5
# ROUTING_FAST_PROVIDER=openai
# ROUTING_FAST_MODEL=gpt-5.4-nano
# PAGE_AGENT_PROVIDER=openai
# PAGE_AGENT_MODEL=gpt-5.4-mini
# SCOUT_AGENT_PROVIDER=openai
# SCOUT_AGENT_MODEL=gpt-5.4-mini
# EMOTIONAL_SYNTHESIS_PROVIDER=openai
# EMOTIONAL_SYNTHESIS_MODEL=gpt-5.4-mini
# COURIER_SUMMARIZER_PROVIDER=openai
# COURIER_SUMMARIZER_MODEL=gpt-5.4-mini
# VISION_PROVIDER=openai
# VISION_MODEL=gpt-5.4-mini
# CODING_AGENT_PROVIDER=claude-code
# CODING_AGENT_CLAUDE_MODEL=sonnet
# CODING_AGENT_CODEX_MODEL=gpt-5.4
# SANDBOX_AGENT_PROVIDER=claude-code
# SANDBOX_AGENT_CLAUDE_MODEL=sonnet
# SANDBOX_AGENT_CODEX_MODEL=gpt-5.4

# Enhanced Recall (memory retrieval pipeline)
# User-specific stopwords (comma-separated, e.g. your name)
# RECALL_USER_STOPWORDS=
# Cache TTL for IDF/graph indexes (ms, default 300000 = 5min)
# RECALL_CACHE_TTL_MS=300000
# LLM reranker
# RECALL_RERANKER_ENABLED=true
# RECALL_RERANKER_PROVIDER=openai
# RECALL_RERANKER_MODEL=gpt-5.4-nano
# RECALL_RERANKER_POOL=15

# Feature Flags
# ENABLE_EMOTION_TAGGING=false

# Telegram Bot Integration
# Get your bot token from @BotFather on Telegram
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# Comma-separated list of allowed Telegram user IDs
# Find your user ID by messaging @userinfobot on Telegram
# TELEGRAM_ALLOWED_USER_IDS=123456789
# Polling interval in ms (default 1000)
# TELEGRAM_POLLING_INTERVAL_MS=1000
